#This is dummy to be changed
JWT_SECRET=replace_with_a_secure_random_secret
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=mysql+pymysql://username:password@localhost/database_name
# Local storage and inference (CPU can be explicitly selected)
UPLOAD_DIR=uploads
YOLO_DEVICE=cpu
PROCESS_FPS=3
# Optional; disabled by default so local analytics requires no cloud service.
CLOUDINARY_UPLOAD_ENABLED=false
CAMERA_HEALTH_MONITOR_ENABLED=true
CAMERA_HEALTH_TIMEOUT_MS=3000
CAMERA_HEALTH_INTERVAL_SECONDS=60
CAMERA_HEALTH_CONCURRENCY=4
CAMERA_HEALTH_OFFLINE_RETRY_SECONDS=180
